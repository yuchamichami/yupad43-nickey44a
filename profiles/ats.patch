diff --git a/config/nickey44a_l.conf b/config/nickey44a_l.conf
index 106ae14..981a399 100644
--- a/config/nickey44a_l.conf
+++ b/config/nickey44a_l.conf
@@ -14,6 +14,8 @@ CONFIG_ZMK_POINTING=y
